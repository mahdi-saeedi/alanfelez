# Copy to .env (never commit .env). Everything is optional: compose has working defaults.

# --- Slow or restricted network: reuse images you already have, or build artifacts on the host ---
# POSTGRES_IMAGE=postgres:16
# REDIS_IMAGE=redis:7-alpine
# KEYCLOAK_VERSION=26.3.0                 # must match the jar if KC_EXTENSIONS_STAGE=extensions-prebuilt
# KC_EXTENSIONS_STAGE=extensions-prebuilt # use services/keycloak/extensions/target/*.jar (task build:local)
# KC_THEME_STAGE=theme-prebuilt         # use apps/keycloak-theme/dist_keycloak/*.jar (task build:local)
# WEB_BUILD_STAGE=prebuilt               # use apps/web/.next/standalone (task build:local)
# ADMIN_BUILD_STAGE=prebuilt             # use apps/admin/dist (task build:local)
# NODE_IMAGE=node:24-alpine
# API_BUILD_STAGE=prebuilt                # use services/api/bin/alanfelez (task build:local)
# API_RUNTIME_IMAGE=alpine:3              # any small image you already have

# --- Host ports (change if they clash with other projects) ---
# API_PORT=8080
# KEYCLOAK_PORT=8081
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# WEB_PORT=3000
# ADMIN_PORT=5173

# --- Local credentials (defaults shown) ---
# POSTGRES_PASSWORD=alanfelez
# KEYCLOAK_DB_PASSWORD=keycloak

# --- Logging ---
# LOG_LEVEL=debug
# LOG_FORMAT=text
