{
  "name": "@alanfelez/keycloak-theme",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Keycloak login theme (Keycloakify + React + Tailwind), incl. custom phone OTP pages",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build-keycloak-theme": "pnpm build && keycloakify build",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "keycloakify": "11.16.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@alanfelez/ui": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "~5.9.3",
    "vite": "8.3.1"
  }
}
