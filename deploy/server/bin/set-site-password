#!/usr/bin/env bash
# The shared username/password in front of staging.alanfelez.ir and admin.staging.alanfelez.ir.
# Writes an encrypted (sealed) secret to /root/sealed/alanfelez-basic-auth.sealed.yaml; Claude copies it into git.
set -uo pipefail
export KUBECONFIG=/etc/rancher/k3s/k3s.yaml
fail() { echo; echo "✗ $*"; echo "Nothing was changed. Run the command again."; exit 1; }
read -rp "Site username (e.g. alanfelez-team): " U || fail "No username was entered."
[[ "$U" =~ ^[A-Za-z0-9._-]{3,32}$ ]] || fail "Use 3–32 letters, digits, dot, dash or underscore."
read -rsp "Site password (hidden, at least 12 characters): " P || fail "No password was entered."; echo
[ ${#P} -ge 12 ] || fail "The password is shorter than 12 characters."
read -rsp "Same password again: " P2 || fail "No password was entered."; echo
[ "$P" = "$P2" ] || fail "The two passwords are different."
umask 077; mkdir -p /root/sealed
line=$(htpasswd -nbB "$U" "$P") || fail "htpasswd failed."
kubectl create secret generic alanfelez-basic-auth -n alanfelez --dry-run=client -o yaml --from-literal=users="$line" \
  | kubeseal --controller-namespace kube-system --controller-name sealed-secrets-controller -o yaml \
  > /root/sealed/alanfelez-basic-auth.sealed.yaml || fail "Could not encrypt the secret."
echo "✓ Saved (encrypted). Tell Claude it is done."
