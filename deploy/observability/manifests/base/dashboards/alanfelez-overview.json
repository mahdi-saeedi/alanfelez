    }
   },
   "id": 3,
   "gridPos": {
    "h": 6,
    "w": 9,
    "x": 10,
    "y": 1
   }
  },
  {
   "type": "stat",
   "title": "Certificate days left",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "min by (instance) ((probe_ssl_earliest_cert_expiry - time()) / 86400)",
     "refId": "A",
     "legendFormat": "{{instance}}"
