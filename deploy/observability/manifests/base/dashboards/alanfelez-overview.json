  {
   "type": "table",
   "title": "Rollouts",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "description": "Healthy = serving the new version. Degraded = stopped, the old version serves (alert DeployStuck).",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max by (name, phase) (rollout_info{namespace=\"alanfelez\"})",
     "refId": "A",
     "legendFormat": "",
     "format": "table",
     "instant": true
    }
   ],
   "transformations": [
    {
     "id": "filterByValue",
     "options": {
      "filters": [
       {
        "fieldName": "Value",
        "config": {
         "id": "equal",
         "options": {
          "value": 1
         }
        }
       }
      ],
      "type": "include",
      "match": "any"
     }
    },
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "Value": true
      }
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "phase"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background"
        }
       },
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "Healthy": {
            "color": "green"
           },
           "Degraded": {
            "color": "red"
           },
           "Paused": {
            "color": "orange"
           },
           "Progressing": {
            "color": "blue"
           }
          }
         }
        ]
       }
      ]
     }
    ]
   },
   "id": 10,
   "gridPos": {
    "h": 7,
    "w": 8,
    "x": 0,
    "y": 17
   }
  },
