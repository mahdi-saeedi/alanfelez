  {
   "type": "stat",
   "title": "Hours since last backup",
   "description": "Nightly at 02:00 UTC (05:30 Tehran). Alert: BackupMissing after 26 h.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(time() - max(cnpg_collector_last_available_backup_timestamp)) / 3600",
     "refId": "A",
     "legendFormat": "last backup"
